String _addKanjiToChoice(String choice) {
  // 螳悟・荳閾ｴ縺ｧ繝槭ャ繝斐Φ繧ｰ
  if (_kanjiMap.containsKey(choice)) {
    return _kanjiMap[choice]!;
  }
  // 驛ｨ蛻・・繝・メ繧定ｩｦ縺ｿ繧具ｼ亥腰隱槫腰菴搾ｼ・
  for (final key in _kanjiMap.keys) {
    if (choice.contains(key)) {
      return choice.replaceAll(key, _kanjiMap[key]!);
    }
  }
  return choice;
}

// 蟄ｦ蟷ｴ蛻･繝ｻ繧ｹ繝・・繧ｸ蛻･繧ｯ繧､繧ｺ繝・・繧ｿ
List<Stage> getStagesForGrade(int grade) {
  switch (grade) {
    case 1: return [..._grade1Stages, ...grade1ExtraStages, ..._grade1ExtraReading];
    case 2: return [..._grade2Stages, ...grade2ExtraStages, ..._grade2ExtraReading];
    case 3: return [..._grade3Stages, ...grade3ExtraStages, ..._grade3ExtraReading];
    case 4: return [..._grade4Stages, ...grade4ExtraStages, ..._grade4ExtraReading];
    case 5: return [..._grade5Stages, ...grade5ExtraStages, ..._grade5ExtraReading];
    case 6: return [..._grade6Stages, ...grade6ExtraStages, ..._grade6ExtraReading];
    default: return _grade1Stages;
  }
}

