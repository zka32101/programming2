rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==================== 共通関数 ====================
    function isAuth() {
      return request.auth != null;
    }

    function isUser(userId) {
      return request.auth.uid == userId;
    }
    
    // ==================== ユーザーデータ ====================
    
    // ユーザープロフィール - 本人のみ読み取り/更新可能
    match /users/{userId} {
      allow read: if request.auth.uid == userId;
      allow write: if request.auth.uid == userId
        && request.resource.data.size() <= 1000000
        && request.resource.data.keys().hasAll(['userId', 'displayName', 'updatedAt']);
    }
    
    // ユーザーの詳細データ
    match /users/{userId}/{document=**} {
      allow read: if request.auth.uid == userId;
      allow write: if request.auth.uid == userId
        && request.resource.data.size() <= 5000000;
      allow delete: if request.auth.uid == userId;
    }
    
    // ==================== English Town データ ====================
    
    // タウン進捗 - 本人のみ
    match /english_town_progress/{userId} {
      allow read: if request.auth.uid == userId;
      allow write: if request.auth.uid == userId
        && request.resource.data.size() <= 100000;
    }
    
    // ストリーク - 本人のみ
    match /english_town_streaks/{userId} {
      allow read: if request.auth.uid == userId;
      allow write: if request.auth.uid == userId
        && request.resource.data.size() <= 50000;
    }
    
    // アナリティクス - 本人のみ書き込み
    match /english_town_analytics/{userId}/{document=**} {
      allow read: if request.auth.uid == userId;
      allow write: if request.auth.uid == userId
        && request.resource.data.size() <= 1000000;
      allow delete: if request.auth.uid == userId;
    }
    
    // ==================== リーダーボード ====================
    
    // リーダーボード - 全員読み取り可、本人のみ書き込み
    match /english_town_leaderboard/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == userId
        && request.resource.data.size() <= 100000
        && request.resource.data.keys().hasAll(['userId', 'displayName', 'totalXp']);
      allow delete: if request.auth.uid == userId;
    }
    
    // ==================== アチーブメント ====================
    
    // アチーブメント - 本人のみ読み取り/書き込み
    match /english_town_achievements/{userId}/{document=**} {
      allow read: if request.auth.uid == userId;
      allow write: if request.auth.uid == userId
        && request.resource.data.size() <= 500000;
      allow delete: if request.auth.uid == userId;
    }
    
    // ==================== ソーシャル機能 ====================
    
    // フレンドリスト
    match /social/users/{userId}/friends/{friendId} {
      allow read: if request.auth.uid == userId || request.auth.uid == friendId;
      allow write: if request.auth.uid == userId;
      allow delete: if request.auth.uid == userId;
    }
    
    // フレンドリクエスト
    match /social/users/{userId}/friend_requests/{requestId} {
      allow read: if request.auth.uid == userId;
      allow write: if request.auth.uid == userId || request.auth.uid == requestId;
      allow delete: if request.auth.uid == userId || request.auth.uid == requestId;
    }
    
    // ==================== メッセージング ====================
    
    // メッセージ - 参加者のみ読み取り可
    match /conversations/{conversationId} {
      allow read: if request.auth.uid in resource.data.participants;
      allow write: if request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
        && request.resource.data.size() <= 100000;
    }
    
    match /conversations/{conversationId}/messages/{messageId} {
      allow read: if request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
      allow create: if request.auth.uid == request.resource.data.senderId
        && request.resource.data.size() <= 50000;
      allow delete: if request.auth.uid == resource.data.senderId;
    }
    
    // ==================== デイリーミッション (shared_core MissionNotifier) ====================

    // 本人のみ
    match /user_missions/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // doc id は "{uid}_{missionId}"
    match /user_mission_progress/{progressId} {
      allow read, write: if request.auth != null
        && progressId.matches(request.auth.uid + '_.*');
    }

    // ==================== 小学コレ！社会 (com.yourwish.shougakukore.shakai2) ====================
    // 出典: social_quiz_app/firestore.rules。既存ルールは変更せず追加のみ。
    // users/{userId} は既存ブロックと OR で評価される(本人のみ書込可・キー制約は社会側では不要)。
    match /users/{userId} {
      allow read, create, update, delete: if isAuth() && isUser(userId);
    }

    // ランキング: 全員読み取り可・クライアントからの書き込み不可(Cloud Functions のみ)
    match /leaderboards/global/entries/{userId} {
      allow read: if isAuth();
      allow write: if false;
    }
    match /leaderboards/weekly/entries/{userId} {
      allow read: if isAuth();
      allow write: if false;
    }
    match /leaderboards/friends/{userId}/entries/{friendId} {
      allow read: if isAuth() && isUser(userId);
      allow write: if false;
    }

    match /quiz/{document=**} {
      allow read: if isAuth();
    }
    match /badges/{document=**} {
      allow read: if isAuth();
    }

    match /quizResults/{userId}/{document=**} {
      allow read, write: if isAuth() && isUser(userId);
    }

    // マルチプレイ(マッチデータ)
    match /matches/{matchId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth() && (
        resource.data.player1Id == request.auth.uid ||
        resource.data.player2Id == request.auth.uid
      );
    }

    match /config/{document=**} {
      allow read: if true;
      allow write: if request.auth.token.admin == true;
    }

    // ==================== その他の制限 ====================
    
    // デフォルト: 全拒否
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
